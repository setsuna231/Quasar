/* simple_calculator.qs - Basic arithmetic operations on two numbers */

let a : int = 12;
let b : int = 5;

print("Addition:", a + b);
print("Subtraction:", a - b);
print("Multiplication:", a * b);
print("Integer Division:", a / b);
print("Modulo:", a % b);
print("Exponent:", a ** b);
print("Floor Division:", a // b);