/* variables.qs - Demonstrate all primitive types */

let age : int = 20;
let height : float = 5.9;
let name : string = "Alice";
let initial : char = 'A';
let is_student : bool = true;

print("Integer:", age);
print("Float:", height);
print("String:", name);
print("Char:", initial);
print("Bool:", is_student);